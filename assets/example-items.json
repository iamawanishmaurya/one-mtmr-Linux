// MTMR-Linux daily preset v2 — widgets + sliders (MTMR units, full bar = 1080)
[
  { "type": "escape", "title": "esc", "width": 64, "align": "left" },

  { "type": "music", "width": 200, "align": "left" },
  { "type": "previous", "width": 40, "align": "center" },
  { "type": "play", "width": 40, "align": "center" },
  { "type": "next", "width": 40, "align": "center" },

  { "type": "cpu", "width": 60, "align": "center" },
  { "type": "battery", "width": 70, "align": "center" },
  { "type": "timeButton", "formatTemplate": "HH:mm", "width": 80, "align": "center" },

  { "type": "brightness", "width": 100, "align": "right" },
  { "type": "volume", "width": 100, "align": "right" },
  { "type": "illuminationDown", "title": "-k", "width": 36, "align": "right" },
  { "type": "illuminationUp", "title": "+k", "width": 36, "align": "right" },
  { "type": "staticButton", "title": "Lock", "width": 60, "align": "right",
    "actions": [{ "trigger": "singleTap", "action": "command", "command": "loginctl lock-session" }] },
  { "type": "exitTouchbar", "title": "X", "width": 36, "align": "right" }
]
