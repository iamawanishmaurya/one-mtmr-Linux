# Maintainer: iamawanishmaurya
pkgname=mtmr-linux
pkgver=1.0.0
pkgrel=1
pkgdesc="MTMR rebuild for Linux — customizable Touch Bar on t2linux MacBooks"
arch=('x86_64')
url="https://github.com/iamawanishmaurya/one-mtmr-Linux"
license=('MIT')
depends=('gcc-libs' 'playerctl' 'libpipewire')
makedepends=('rust')
backup=('etc/mtmr/items.json')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir"
  cargo build --release
}

package() {
  install -Dm755 target/release/mtmr "$pkgdir/usr/bin/mtmr"
  install -Dm644 packaging/mtmr.service "$pkgdir/usr/lib/systemd/system/mtmr.service"
  install -Dm644 packaging/60-mtmr.rules "$pkgdir/usr/lib/udev/rules.d/60-mtmr.rules"
  install -Dm644 assets/example-items.json "$pkgdir/etc/mtmr/items.json"
  install -Dm644 README.md "$pkgdir/usr/share/doc/mtmr-linux/README.md"
}
